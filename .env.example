# YouTube Data API 키 (서버 전용)
# 이 값은 서버에서만 사용되며 SSE/GET 응답 등 클라이언트로는 절대 전송되지 않습니다.
# NEXT_PUBLIC_ 접두사를 붙이면 번들에 노출되므로 절대 사용하지 마세요.
# 판매자가 개인 키를 등록하지 않았을 때 사용하는 서버 공용 폴백 키 (선택)
YOUTUBE_API_KEY=

# ================= YouTube 계정 연동 (Google OAuth) =================
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI 에 {NEXTAUTH_URL}/api/auth/youtube/callback 을 등록해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 서비스 기본 URL (OAuth redirect_uri 계산에 사용). 미설정 시 요청 origin 을 사용합니다.
# 예: http://localhost:3014
NEXTAUTH_URL=
